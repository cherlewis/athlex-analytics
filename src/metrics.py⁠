    sample_power = pd.Series(np.random.normal(230, 25, 3600)) # 1 hora de ciclismo
    sample_hr = pd.Series(np.random.normal(155, 8, 3600))

    calc = BiometricsCalculator(ftp=260, max_hr=188, rest_hr=48)
    np_calc = calc.calculate_normalized_power(sample_power)
    if_calc = calc.calculate_intensity_factor(np_calc)
    tss_calc = calc.calculate_tss(3600, np_calc, if_calc)
    trimp_calc = calc.calculate_banister_trimp(sample_hr, 3600)

    print(f"--- Métricas Calculadas ---")
    print(f"NP: {np_calc} W | IF: {if_calc} | TSS: {tss_calc} | TRIMP: {trimp_calc}")
